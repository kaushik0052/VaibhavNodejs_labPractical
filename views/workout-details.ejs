<%- include('partials/head') %>
<%- include('partials/header') %>
<div class="container py-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
          <h1 class="h4">Workout Details</h1>
          <p class="text-muted mb-0"><strong>Type:</strong> <%= workout.workoutType %></p>
        </div>
        <div>
          <a class="btn btn-outline-secondary btn-sm" href="/workouts/<%= workout.id %>/edit">Edit</a>
          <form class="d-inline" method="POST" action="/workouts/<%= workout.id %>?_method=DELETE">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
      <dl class="row">
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9"><%= workout.workoutDate.toISOString().split('T')[0] %></dd>

        <dt class="col-sm-3">Duration</dt>
        <dd class="col-sm-9"><%= workout.duration %> minutes</dd>

        <dt class="col-sm-3">Calories Burned</dt>
        <dd class="col-sm-9"><%= workout.caloriesBurned %></dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9"><%= workout.notes %></dd>
      </dl>
      <a href="/workouts" class="btn btn-secondary">Back to Workouts</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
